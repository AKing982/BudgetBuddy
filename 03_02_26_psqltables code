CREATE TABLE Merchants
(
    id SERIAL PRIMARY KEY,
    merchantName VARCHAR(255) NOT NULL,
    merchantCategory VARCHAR(255),
    date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE PlaidCategories
(
    id SERIAL PRIMARY KEY,
    categoryId VARCHAR(255),
    primary_category VARCHAR(255),
    secondary_category VARCHAR(255),
    matched_category VARCHAR(255)
);

CREATE TABLE SystemCategoryRules
(
    id SERIAL PRIMARY KEY,
    plaid_category_id BIGINT,
    category_id BIGINT,
    merchant VARCHAR(255),
    category VARCHAR(255),
    amount DECIMAL(10, 2),
    matched_category VARCHAR(255),
    priority INTEGER DEFAULT 1,
    type VARCHAR(75),

    FOREIGN KEY REFERENCES PlaidCategories(id)
);
