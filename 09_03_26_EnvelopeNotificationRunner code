@Service
@Slf4j
public class EnvelopeNotificationRunner
{
    private final EnvelopeNotificationBuilder envelopeNotificationBuilder;
    private final EnvelopeNotificationService envelopeNotificationService;
    private final EnvelopeContributionValidator envelopeContributionValidator;
    private final EnvelopeService envelopeService;

    @Autowired
    public EnvelopeNotificationRunner(EnvelopeNotificationBuilder envelopeNotificationBuilder,
                                      EnvelopeNotificationService envelopeNotificationService,
                                      EnvelopeContributionValidator envelopeContributionValidator,
                                      EnvelopeService envelopeService)
    {
        this.envelopeNotificationBuilder = envelopeNotificationBuilder;
        this.envelopeNotificationService = envelopeNotificationService;
        this.envelopeContributionValidator = envelopeContributionValidator;
        this.envelopeService = envelopeService;
    }

    public Optional<EnvelopeNotificationStatus> sendEnvelopeNotificationAccept(Long notificationId)
    {
        try
        {
            EnvelopeNotification envelopeNotification = envelopeNotificationService.findEnvelopeNotificationById(notificationId);
                .orElseThrow((() -> new EnvelopeException("Envelope Notification with id: " + notificationId + " not found")));
            Long envelopeId = envelopeNotification.getEnvelopeId();
            Envelope envelope = envelopeService.findByEnvelopeId(envelopeId)
                .orElseThrow(() -> new EnvelopeException("Envelope with id: " + envelopeId + " not found"));
            LocalDate scheduledContributionDate = envelopeNotification.getDateToContribute();
            List<Contributions> envelopeContributions = envelope.getContributions();
            Contributions contributionForNotification = envelopeContributions.stream()
                .filter(e -> e.getContributionDate().equals(scheduledContributionDate))
                .findFirst()
                .get();
            ContributionValidationResult validationCheck = envelopeContributionValidator.runValidationCheck(envelopeNotification, contributionForNotification).get();
            if(checkIsValidated(validationCheck))
            {
                EnvelopeNotificationStatus status = envelopeNotificationService.sendEnvelopeAcceptedNotification(notificationId).get();    
            }
            final String failedValidationMessage = "Envelope contribution: " + contributionForNotification.toString() + " failed validation check for notification Id: " + notificationId; 
            return Optional.of(EnvelopeNotificationStatus.builder()
                .isAccepted(true)
                .notificationId(notificationId)
                .status(failedValidationMessage)
                .build());

        }catch(RunnerException ex){
            log.error("There was an error sending the envelope notification accept: ", ex);
            return Optional.empty();
        }
    }

    public List<EnvelopeNotification> createEnvelopeNotifications(Long envelopeId)
    {
        return null;
    }

    private boolean checkIsValidated(ContributionValidationResult validationResult)
    {
        return validationResult.isValidated()
        && (!validationResult.matchedAccountId().isEmpty() || !validationResult.matchedTransactionId().isEmpty());
    }
}


